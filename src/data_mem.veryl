import utils::*;

module DataMem (
    clk   : input  clock    ,
    rst   : input  reset    ,
    addr  : input  logic<32>,
    data  : output logic<32>,
    funct3: input  logic<3> ,
    wen   : input  logic    ,
    wdata : input  logic<32>,
) {
    var mem: logic<8> [1024 * 4];

    always_comb {
        data = case funct3 {
            3'b000 : {mem[addr][7] repeat 24, mem[addr]},
            3'b001 : {mem[addr][7] repeat 16, mem[addr + 1], mem[addr]},
            3'b010 : {mem[addr + 3], mem[addr + 2], mem[addr + 1], mem[addr]},
            3'b100 : {1'b0 repeat 24, mem[addr]},
            3'b101 : {1'b0 repeat 16, mem[addr + 1], mem[addr]},
            3'b110 : {mem[addr + 3], mem[addr + 2], mem[addr + 1], mem[addr]},
            default: 'x,
        };
    }

    always_ff {
        if wen == 1 {
            case funct3 {
                3'b000: {
                    mem[addr] = wdata[7:0];
                }
                3'b001: {
                    mem[addr]     = wdata[7:0];
                    mem[addr + 1] = wdata[15:8];
                }
                3'b010: {
                    mem[addr]     = wdata[7:0];
                    mem[addr + 1] = wdata[15:8];
                    mem[addr + 2] = wdata[23:16];
                    mem[addr + 3] = wdata[31:24];
                }
                default: {
                    mem[addr] = wdata[7:0];
                }
            }
        }
    }
}
