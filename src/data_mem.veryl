import utils::*;

module DataMem (
    clk    : input  clock    ,
    rst    : input  reset    ,
    addr   : input  logic<32>,
    data   : output logic<32>,
    funct3 : input  logic<3> ,
    wen    : input  logic    ,
    wdata  : input  logic<32>,
    tx_line: output logic    ,
) {
    var mem: logic<8> [1024 * 4];

    var tx_reg        : logic<8>;
    var tx_start      : logic   ;
    var tx_busy       : logic   ;
    const UART_ADDR     : u32      = 32'hFF000000;
    const UART_FLAG_ADDR: u32      = 32'hFF000001;

    inst uart: UART (
        clk             ,
        rst             ,
        tx_data : tx_reg,
        tx_start        ,
        tx_busy         ,
        tx_line         ,
    );

    always_ff {
        if wen == 1 {
            if addr == UART_ADDR {
                tx_reg   = wdata[7:0];
                tx_start = 1;
            } else {
                case funct3 {
                    3'b000: {
                        mem[addr] = wdata[7:0];
                    }
                    3'b001: {
                        mem[addr]     = wdata[7:0];
                        mem[addr + 1] = wdata[15:8];
                    }
                    3'b010: {
                        mem[addr]     = wdata[7:0];
                        mem[addr + 1] = wdata[15:8];
                        mem[addr + 2] = wdata[23:16];
                        mem[addr + 3] = wdata[31:24];
                    }
                    default: {
                        mem[addr] = wdata[7:0];
                    }
                }
                tx_start = 0;
            }
        } else {
            tx_start = 0;
        }

        data = if addr == UART_FLAG_ADDR ?
            {1'b0 repeat 7, tx_busy}
        :
            case funct3 {
                3'b000 : {mem[addr][7] repeat 24, mem[addr]},
                3'b001 : {mem[addr][7] repeat 16, mem[addr + 1], mem[addr]},
                3'b010 : {mem[addr + 3], mem[addr + 2], mem[addr + 1], mem[addr]},
                3'b100 : {1'b0 repeat 24, mem[addr]},
                3'b101 : {1'b0 repeat 16, mem[addr + 1], mem[addr]},
                3'b110 : {mem[addr + 3], mem[addr + 2], mem[addr + 1], mem[addr]},
                default: 'x,
            }
        ;
    }
}
