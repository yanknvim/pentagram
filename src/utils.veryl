package utils {
    enum Opcode: logic<7> {
        LUI = 7'b0110111,
        AUIPC = 7'b0010111,
        OP = 7'b0110011,
        OP_IMM = 7'b0010011,
        STORE = 7'b0100011,
        LOAD = 7'b0000011,
    }

    enum InstType {
        R,
        I,
        S,
        B,
        U,
        J,
    }

    struct ExecCtrl {
        itype  : InstType,
        is_lui : logic   ,
        is_reg : logic   ,
        is_load: logic   ,
    }
}
