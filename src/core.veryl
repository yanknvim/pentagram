import utils::*;

module Core (
    clk    : input  clock,
    rst    : input  reset,
    tx_line: output logic,
) {
    var pc         : logic   <32>;
    var instruction: logic   <32>;
    var imm        : logic   <32>;
    var ctrl       : ExecCtrl    ;
    var wb_data    : logic   <32>;
    var alu_data   : logic   <32>;
    var b_flag     : logic       ;

    let funct3: logic<3> = instruction[14:12];

    always_ff {
        if_reset {
            pc = 32'b0;
        } else if ctrl.is_jump || (ctrl.is_branch && b_flag) {
            pc = pc + $signed(imm);
        } else {
            pc = pc + 4;
        }
    }

    // Register
    let rs1_addr: logic<5>  = instruction[19:15];
    let rs2_addr: logic<5>  = instruction[24:20];
    var rs1_data: logic<32>;
    var rs2_data: logic<32>;
    let rd      : logic<5>  = instruction[11:7];
    inst regfile: Regfile (
        clk                  ,
        rst                  ,
        rs1_addr             ,
        rs1_data             ,
        rs2_addr             ,
        rs2_data             ,
        wen     : ctrl.is_reg,
        waddr   : rd         ,
        wdata   : wb_data    ,
    );

    // Decoder
    inst decoder: Decoder (
        instruction  ,
        imm          ,
        ctrl         ,
    );

    // Memory
    inst inst_mem: InstMem (
        clk              ,
        rst              ,
        addr: pc >> 2    ,
        data: instruction,
    );

    var mem_data: logic<32>;
    inst data_mem: DataMem (
        clk                               ,
        rst                               ,
        addr   : rs1_data + imm           ,
        data   : mem_data                 ,
        wen    : ctrl.itype == InstType::S,
        wdata  : wb_data                  ,
        funct3 : funct3                   ,
        tx_line                           ,
    );

    // ALU
    let a: logic<32> = case ctrl.itype {
        InstType::I, InstType::R: rs1_data,
        InstType::U             : pc,
        default                 : 'x,
    };

    let b: logic<32> = case ctrl.itype {
        InstType::I, InstType::U: imm,
        InstType::R             : rs2_data,
        default                 : 'x,
    };

    let funct7: logic<7> = instruction[31:25];
    inst alu: Alu (
        a               ,
        b               ,
        ctrl            ,
        funct3          ,
        funct7          ,
        data  : alu_data,
    );

    // Branch
    inst branch: Branch (
        rs1   : rs1_data,
        rs2   : rs2_data,
        funct3          ,
        branch: b_flag  ,
    );

    always_comb {
        wb_data = case ctrl.itype {
            InstType::I : switch {
                ctrl.is_load: mem_data,
                ctrl.is_jump: pc + 4,
                default     : alu_data
            },
            InstType::R: alu_data,
            InstType::U: if ctrl.is_lui ? imm : pc + imm,
            InstType::S: rs2_data,
            InstType::J: pc + 4,
            default    : 'x,
        };
    }
}
