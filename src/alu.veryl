import utils::*;

module Alu (
    a     : input  logic   <32>,
    b     : input  logic   <32>,
    ctrl  : input  ExecCtrl    ,
    funct3: input  logic   <3> ,
    funct7: input  logic   <7> ,
    data  : output logic   <32>,
) {
    let slt : logic<32> = {1'b0 repeat 31, $signed(a) <: $signed(b)};
    let sltu: logic<32> = {1'b0 repeat 31, a <: b};
    let srl : logic<32> = a >> b[4:0];
    let sra : logic<32> = a >> $signed(b[4:0]);

    always_comb {
        data = case ctrl.itype {
            InstType::I, InstType::R: case funct3 {
                3'b000 : if ctrl.itype == InstType::I | funct7[5] == 0 ? a + b : a - b,
                3'b010 : slt,
                3'b011 : sltu,
                3'b100 : a ^ b,
                3'b110 : a | b,
                3'b111 : a & b,
                3'b001 : a << b[4:0],
                3'b101 : if funct7[5] == 1 ? sra : srl,
                default: 'x,
            },
            default: a + b,
        };
    }
}
